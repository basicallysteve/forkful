NODE_ENV=local

# Session signing key — generate with: openssl rand -base64 32
JWT_SECRET=

# Supabase Database Connection (Transaction Pooler URL from Supabase dashboard)
DATABASE_URL=

# USDA FoodData Central API key — get a free key at https://fdc.nal.usda.gov/api-key-signup.html
USDA_API_KEY=

# Sentry (all optional locally; Sentry is only enabled in production builds)
# Server/edge DSN and browser DSN (same value is fine)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Used at build time to upload source maps
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
