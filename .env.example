NODE_ENV=local

# Session signing key — generate with: openssl rand -base64 32
JWT_SECRET=

# Supabase Database Connection (Transaction Pooler URL from Supabase dashboard)
DATABASE_URL=

# USDA FoodData Central API key — get a free key at https://fdc.nal.usda.gov/api-key-signup.html
USDA_API_KEY=

# Sentry (all optional locally; Sentry is only enabled in production builds)
# Server/edge DSN and browser DSN (same value is fine)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Used at build time to upload source maps
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Resend sandbox/test key. Outside production (VERCEL_ENV !== 'production') email is sent
# with this key only; if unset or empty, email is suppressed. RESEND_API_KEY (production)
# is never used outside production.
RESEND_SANDBOX_API_KEY=

# Invite-only switch (ADR-0032, #374). Production reads the Vercel flag `invite-only-access`
# (on = waitlist mode, off = open sign-up; if it can't be read the app stays in waitlist mode).
# Locally there is no Vercel connection, so set this: true = waitlist mode, false = open sign-up.
# Only the exact string `false` opens sign-up; any other non-empty value means waitlist mode.
# Unset or empty falls through to the flag, which fails closed to waitlist mode.
# Also usable on Vercel Preview (INVITE_ONLY_ACCESS=false). It is ignored in production
# (VERCEL_ENV=production), which reads only the Vercel flag.
INVITE_ONLY_ACCESS=
